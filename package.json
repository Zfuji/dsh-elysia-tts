{
  "name": "dsh-elysia-tts",
  "version": "0.11.0",
  "description": "爱莉希雅音色朗读：把 DSH 里说完的每一轮回复，用本地 GPT-SoVITS 流式念出来；选中文字右键即可朗读，8 档语气 + 情绪参考音 + 静音裁剪；支持选中文字/文件朗读",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zfuji/dsh-elysia-tts.git"
  },
  "homepage": "https://github.com/Zfuji/dsh-elysia-tts#readme",
  "bugs": {
    "url": "https://github.com/Zfuji/dsh-elysia-tts/issues"
  },
  "keywords": [
    "dsh",
    "tts",
    "gpt-sovits",
    "voice-cloning",
    "text-to-speech"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "ACKNOWLEDGMENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/helpers.test.mjs test/integration.test.mjs",
    "lint": "oxlint lib test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "external": []
    }
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10"
  }
}
